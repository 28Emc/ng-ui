{
  "name": "@emc-dev/ng-ui",
  "version": "1.1.0",
  "description": "Angular UI component library with CDK, Forms, Overlay, and Router.",
  "license": "MIT",
  "keywords": [
    "angular",
    "ui",
    "components",
    "design-system",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "directory": "../../dist/ng-ui"
  },
  "scripts": {
    "build": "ng build ng-ui",
    "postbuild": "node ../../scripts/patch-ng-ui-exports.mjs",
    "build:prod": "ng build ng-ui --configuration production",
    "analyze": "node ../../scripts/analyze-ng-ui.mjs",
    "test": "ng test ng-ui",
    "lint": "ng lint ng-ui"
  },
  "peerDependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@lucide/angular": "^1.28.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "axe-core": "^4.13.0"
  }
}
